# LLM model string (litellm format). Examples:
#   gemini/gemini-2.0-flash   (set GEMINI_API_KEY)
#   gpt-4o-mini               (set OPENAI_API_KEY)
#   anthropic/claude-3-5-haiku-latest (set ANTHROPIC_API_KEY)
#   ollama/llama3.1           (local, no key)
LLM_MODEL=gemini/gemini-2.0-flash

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
